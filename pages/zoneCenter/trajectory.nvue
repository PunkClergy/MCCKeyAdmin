<template>
	<view class="container" :style="containerStyle" @touchmove.prevent="handleTouchMove">
		<!-- 车辆选择卡 -->
		<view class="key-card">
			<view class="key-card__empty" @tap="handleJumpVehicle" v-if="!vehicle_info?.sn">
				<view class="key-empty__left">
					<image src="/static/images/01.png" class="key-empty__icon" mode="aspectFit"></image>
					<text class="key-empty__text">{{ tips.PleaseSelectCar[lang] }}</text>
				</view>
				<image src="/static/images/right_1.png" class="key-empty__arrow" mode="aspectFit"></image>
			</view>

			<view class="key-car" v-else>
				<view class="key-car__head">
					<view class="key-car__left">
						<view class="key-plate">
							<image src="/static/images/01.png" class="key-plate__icon" mode="aspectFit"></image>
							<text class="key-plate__text" lines="1">{{ vehicle_info?.platenumber || vehicle_info?.plateNumber }}</text>
						</view>
						<view class="key-tag">
							<text class="key-tag__text" lines="1">{{vehicle_info.vehicleSerialName||tips.NoData[lang]}}{{vehicle_info.vehicleModeName||''}}</text>
						</view>
					</view>
					<view class="key-switch" @tap="handleJumpVehicle">
						<text class="key-switch__text">{{ tips.ReSelect[lang] }}</text>
						<image src="/static/images/right_1.png" class="key-switch__arrow" mode="aspectFit"></image>
					</view>
				</view>

				<view class="key-line"></view>

				<view class="key-meta">
					<view class="key-meta__item">
						<text class="key-meta__label">{{ tips.VIN[lang] }}</text>
						<text class="key-meta__value" lines="1">{{vehicle_info?.vin||tips.NoData[lang]}}</text>
					</view>
					<view class="key-meta__item key-meta__item--gap">
						<text class="key-meta__label">{{ tips.DeviceID[lang] }}</text>
						<text class="key-meta__value" lines="1">{{vehicle_info?.sn||tips.NoData[lang]}}</text>
					</view>
				</view>
			</view>
		</view>

<view class="picker-mask" @click="closePicker" v-if="showPicker">
			<view class="picker-panel" @click.stop="">
				<view class="panel-body">
					<view class="panel-title">{{ tips.PleaseSelectDateRange[lang] }}</view>

					<picker mode="date" :value="startDate" @change="onStartChange">
						<view class="picker-item">
							<text class="picker-label">{{ tips.StartDate[lang] }}</text>
							<text class="picker-val">{{ startDate || tips.PleaseSelect[lang] }}</text>
						</view>
					</picker>

					<picker mode="date" :value="endDate" @change="onEndChange">
						<view class="picker-item">
							<text class="picker-label">{{ tips.EndDate[lang] }}</text>
							<text class="picker-val">{{ endDate || tips.PleaseSelect[lang] }}</text>
						</view>
					</picker>

					<view class="btn-group">
						<text class="picker-btn picker-btn__cancel" @click="closePicker">{{ tips.Cancel[lang] }}</text>
						<text class="picker-btn picker-btn__confirm" @click="confirmPicker">{{ tips.Confirm[lang] }}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 车控 WebView -->
		<view class="key-web">
			<web-view ref="webview" @onPostMessage="handlePostMessage" :src="webUrlWithTimestamp"
				:style="{ height: contentHeight + 'px' }"></web-view>
		</view>
	</view>
</template>

<script>
	import {
		tips
	} from '@/utils/langtips.js'
	import {
		titles
	} from '@/utils/langtitle.js'
	import {
		info_screen
	} from '@/utils/scheme/screen.js'
	import {
		u_getAllCarPoisiton,
		u_operation,
		u_getTrackPlayback
	} from '@/api'
	import 'url-search-params-polyfill';
	// 常量定义
	const DATA_SEND_INTERVAL = 1000;
	const NAVBAR_HEIGHT = {
		ios: 49,
		android: 44,
		default: 44
	};

	export default {
		components: {},

		data: () => ({
			lang: 'enUs',
			tips: tips,

			screenInfo: {},
			nowTimestamp: Date.now(),
			vehicle_info: {},
			info: [],
			sendDataTimeout: null,
			webviewReady: false,
			dataLoaded: false,
			showPicker: false,
			startDate: '',
			endDate: '',
			lat: []
		}),

		computed: {
			containerStyle() {
				return {
					height: `${this.screenInfo.windowHeight || 667}px`
				};
			},

			webUrlWithTimestamp() {
				return `/hybrid/html/trajectory.html?nowTime=${this.nowTimestamp}`;
			},

			statusBarHeight() {
				return this.screenInfo.statusBarHeight || 0;
			},

			navBarHeight() {
				return NAVBAR_HEIGHT[this.screenInfo.platform] || NAVBAR_HEIGHT.default;
			},

			contentHeight() {
				const {
					screenHeight
				} = this.screenInfo;
				const hasPlate = this.vehicle_info?.platenumber || this.vehicle_info?.plateNumber;
				return screenHeight - (this.statusBarHeight + this.navBarHeight + (hasPlate ? 100 : 60));
			}
		},

		onLoad(options) {
			const parsed = JSON.parse(options?.datails || '{}') || {};
			// 列表口径 platenumber 与点位口径 plateNumber 统一，避免任一口径缺失时车牌空白
			if (!parsed.platenumber && parsed.plateNumber) parsed.platenumber = parsed.plateNumber;
			if (!parsed.plateNumber && parsed.platenumber) parsed.plateNumber = parsed.platenumber;
			this.vehicle_info = parsed;
			this.initialScreenInfo();
		},

		async onShow() {
			// 多语言 + 导航栏标题
			this.lang = uni.getStorageSync('language') || 'enUs'
			uni.setNavigationBarTitle({
				title: titles['zoneCenter/trajectory'][this.lang]
			})

			try {
				// webview 即将因 nowTimestamp 变化而重载，重置就绪/数据标志，
				// 等新页面脚本重新上报 ready 后再下发，避免消息落在监听器注册前丢失
				this.webviewReady = false;
				this.dataLoaded = false;
				this.nowTimestamp = Date.now();
				await this.initSearchLink();
			} catch (error) {
				console.error('数据初始化失败:', error);
				uni.showToast({
					title: this.tips.DataLoadFailed[this.lang],
					icon: 'none'
				});
			}
		},

		onUnload() {
			this.clearSendDataTimer();
		},

		methods: {
			handleDate() {
				if (this.vehicle_info?.sn) {
					this.showPicker = true;
				} else {
					uni.showToast({
						title: this.tips.PleaseSelectCarFirst[this.lang],
						icon: 'none'
					})
				}
			},
			// 初始化屏幕信息
			async initialScreenInfo() {
				try {
					this.screenInfo = await info_screen();
				} catch (error) {
					console.error('[ScreenInfo] 获取屏幕信息失败:', error);
					uni.showToast({
						title: this.tips.DeviceInfoFailed[this.lang],
						icon: 'none'
					});
				}
			},

			// 获取车辆位置数据
			async initSearchLink() {
				try {
					const res = await u_getAllCarPoisiton();
					this.info = res.content || [];
					this.syncPlateFromInfo();
					this.dataLoaded = true;
					this.trySendData();
				} catch (error) {
					console.error('车辆位置请求失败:', error);
					// 即使请求失败也标记为已尝试，保证按钮文案仍能下发
					this.dataLoaded = true;
					this.trySendData();
				}
			},

			// 数据与 webview 均就绪后才真正下发，解决时序竞态导致的丢消息
			trySendData() {
				if (this.webviewReady && this.dataLoaded) {
					this.sendDataToWebviewDebounced();
				}
			},

			// 防抖发送数据
			sendDataToWebviewDebounced() {
				this.clearSendDataTimer();

				var obj = {
					type: 'elctrncky',
					payload: this.info,
					vehicle_info: this.vehicle_info,
					lang: this.lang,
					lat: this.lat
				}
				console.log('开始发送消息', obj);
				this.sendDataTimeout = setTimeout(() => {
					this.sendDataToWebview(obj);
				}, DATA_SEND_INTERVAL);
			},

			// 清理定时器
			clearSendDataTimer() {
				if (this.sendDataTimeout) {
					clearTimeout(this.sendDataTimeout);
					this.sendDataTimeout = null;
				}
			},

			// 向Webview发送数据
			sendDataToWebview(data) {
				const payload = JSON.stringify(data);
				const jsStr = `window.onAppMessage(${payload}, '*')`;
				// #ifdef APP-PLUS
				this.$refs.webview?.evalJS(jsStr);
				// #endif

				// #ifdef H5
				const iframe = document.querySelector('web-view iframe');
				iframe?.contentWindow?.postMessage(data, '*');
				// #endif
			},

			// 页面跳转
			handleJumpVehicle() {
				uni.redirectTo({
					url: `/pages/zoneCenter/carKeyConfig?source=/pages/zoneCenter/trajectory`
				});
			},

			// 消息处理
			handlePostMessage(evt) {
				const messageData = evt?.detail?.data?.[0] || {};

				// webview 脚本就绪信号：收到后置就绪标志并尝试下发数据
				if (messageData.type === 'webview-ready') {
					this.webviewReady = true;
					this.trySendData();
					return;
				}

				const {
					source
				} = messageData;

				if (!source) return;

				// 换车判定快照：sn 分支会改车牌，必须在处理前先记下原车牌
				const plateBefore = this.vehicle_info?.platenumber || this.vehicle_info?.plateNumber || '';

				const ACTION_HANDLERS = {
					3: () => this.handleVehicle(source),
					1: () => this.handleVehicle(source),
					5: () => this.handleVehicle(source),
					8: () => this.handleVehicle(source),
					6: () => this.handleVehicle(source),
					100: () => this.handleDate(),
					'sn': () => {
						// webview 只回传 { source, sn, plateNumber }，整体覆盖会把已选车辆的车牌/VIN 冲掉
						const plate = messageData.plateNumber || ''
						this.applyVehiclePatch({
							sn: messageData.sn,
							plateNumber: plate || this.vehicle_info?.plateNumber,
							platenumber: plate || this.vehicle_info?.platenumber
						})
						// 换到另一台车：上一台车的轨迹不能留在地图上
						const prevPlate = this.vehicle_info?.platenumber || this.vehicle_info?.plateNumber || ''
						if (plate && prevPlate && plate !== prevPlate) {
							this.lat = []
							this.sendDataToWebviewDebounced()
						}
					}
				};

				const handler = ACTION_HANDLERS[source];
				if (handler) handler();

				const targetPlate = evt.detail.data[0]?.plateNumber;
				if (!targetPlate) return;

				const matchedItem = this.info.find(item => item.plateNumber === targetPlate || item.platenumber === targetPlate);
				if (!matchedItem) return;

				// 地图点位接口只返回 plateNumber/sn/经纬度，不能整体替换车辆信息
				const currentPlate = plateBefore
				const patch = {
					sn: matchedItem.sn || this.vehicle_info?.sn,
					plateNumber: targetPlate,
					platenumber: targetPlate
				}
				if (currentPlate && currentPlate !== targetPlate) {
					// 切换到另一台车：清掉旧车专属字段，避免显示错车的 VIN / 打开错车的照片
					patch.vin = matchedItem.vin || ''
					patch.id = matchedItem.id || ''
					patch.vehicleSerialName = matchedItem.vehicleSerialName || ''
					patch.vehicleModeName = matchedItem.vehicleModeName || ''
					patch.uploadImgUrl = ''
					patch.uploadImgUrlTwo = ''
					patch.uploadImgUrlThree = ''
					patch.uploadImgUrlFour = ''
					patch.uploadImgUrlFive = ''
				}
				this.applyVehiclePatch(patch)
			},

			// 兜底：路线参数没带车牌（或只带另一种字段名）时，用点位列表按 sn 补回来
			syncPlateFromInfo() {
				const cur = this.vehicle_info || {};
				if (cur.platenumber || cur.plateNumber) return;
				if (!cur.sn) return;
				const found = this.info.find(item => String(item.sn) === String(cur.sn));
				if (!found || !found.plateNumber) return;
				this.applyVehiclePatch({ plateNumber: found.plateNumber });
			},

			// 合并车辆信息：只覆盖传入的字段，避免少字段消息把已选车辆冲成空对象
			applyVehiclePatch(patch) {
				const base = this.vehicle_info || {}
				const next = {}
				for (const key in base) {
					if (Object.prototype.hasOwnProperty.call(base, key)) next[key] = base[key]
				}
				// 车牌只做别名归一，不允许被空值覆盖（这是车牌回显消失的根因之一）
				const plate = patch.platenumber || patch.plateNumber || ''
				if (plate) {
					patch.platenumber = plate
					patch.plateNumber = plate
				} else {
					delete patch.platenumber
					delete patch.plateNumber
				}
				for (const key in patch) {
					if (patch[key] !== undefined) next[key] = patch[key]
				}
				this.vehicle_info = next
			},

			async handleVehicle(evt) {
			  uni.showLoading({
			    title: this.tips.Processing[this.lang],
			    mask: true // 遮罩，阻止点击，防止重复提交
			  })
			  try {
			    const res = await u_operation({
			      sn: this.vehicle_info?.sn,
			      operationType: evt,
			      _timestamp: Date.now()
			    });
			    console.log(res,'resres')
			    uni.showToast({ 
			      title: res.msg, 
			      icon: 'none', 
			      duration: 2000 
			    });
			  } catch (error) {
			    console.error('handleVehicle异常：', error)
			    uni.showToast({ 
			      title: this.tips.NetError[this.lang],
			      icon: 'none' 
			    })
			  } finally {
			    // ✅ 不管try成功还是catch报错，都会关闭loading
			    uni.hideLoading()
			  }
			},

			handleTouchMove() {},
			closePicker() {
				this.showPicker = false;
			},

			async confirmPicker() {
				if (!this.startDate || !this.endDate) {
					uni.showToast({
						title: this.tips.PleaseSelectFullDate[this.lang],
						icon: 'none'
					});
					return;
				}

				if (!this.vehicle_info?.sn) {
					uni.showToast({
						title: this.tips.PleaseSelectCarFirst[this.lang],
						icon: 'none'
					});
					return;
				}

				const params = {
					sn: this.vehicle_info.sn,
					startDate: `${this.startDate} 00:00`,
					endDate: `${this.endDate} 23:59`
				};

				try {
					const responeInfo = await u_getTrackPlayback(params);
					if (responeInfo?.code === 1000) {
						const trackList = responeInfo?.content || [];
						this.lat = trackList.map(item => ({
							lat: item.tlatitude,
							lng: item.tlongitude,
							gpstime: item.gpstime
						}));
		
						this.showPicker = false;
						this.sendDataToWebviewDebounced();
						uni.showToast({
							title: this.tips.TrackLoadSuccess[this.lang],
							icon: 'success'
						});
					} else {
						uni.showToast({
							title: responeInfo?.msg || this.tips.NoTrackData[this.lang],
							icon: 'none'
						});
					}
				} catch (err) {
					console.error('轨迹请求失败：', err);
					uni.showToast({
						title: this.tips.TrackRequestFailed[this.lang],
						icon: 'none'
					});
				}
			},
			onStartChange(e) {
				this.startDate = e.detail.value;
			},
			onEndChange(e) {
				this.endDate = e.detail.value;
			}
		}
	}
</script>

<style>
	/* ===== 基础布局 ===== */
	.container {
		width: 750rpx;
		display: flex;
		flex-direction: column;
		align-items: center;
		background-color: #ffffff;
	}

	/* ===== 车辆卡片外壳 ===== */
	.key-card {
		width: 718rpx;
		display: flex;
		flex-direction: column;
		margin: 12rpx 0 8rpx;
		padding: 10rpx;
		border-radius: 18rpx;
		background-color: #ffffff;
		border: 1rpx solid #e8f1fa;
		box-shadow: 0 6rpx 18rpx rgba(19, 96, 160, 0.06);
	}

	/* ===== 未选车：入口条 ===== */
	.key-card__empty {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		height: 80rpx;
		padding: 0 20rpx;
		border-radius: 12rpx;
		background-color: #f6fbff;
		border: 1rpx solid #dfeaf5;
	}
	.key-empty__left {
		display: flex;
		flex-direction: row;
		align-items: center;
	}
	.key-empty__icon {
		width: 34rpx;
		height: 34rpx;
		margin-right: 12rpx;
	}
	.key-empty__text {
		font-size: 26rpx;
		color: #3d6f9e;
	}
	.key-empty__arrow {
		width: 22rpx;
		height: 22rpx;
	}

	/* ===== 已选车：车辆信息 ===== */
	.key-car {
		display: flex;
		flex-direction: column;
		padding: 6rpx 4rpx 2rpx;
	}
	.key-car__head {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}
	.key-car__left {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex: 1;
	}
	.key-plate {
		display: flex;
		flex-direction: row;
		align-items: center;
		flex-shrink: 0;
		padding: 6rpx 12rpx;
		border-radius: 10rpx;
		background-color: #f2f8ff;
		border: 1rpx solid #dbe9f8;
	}
	.key-plate__icon {
		width: 32rpx;
		height: 32rpx;
		margin-right: 8rpx;
	}
	.key-plate__text {
		flex-shrink: 0;
		font-size: 28rpx;
		font-weight: bold;
		color: #14324e;
	}
	.key-tag {
		margin-left: 12rpx;
		padding: 4rpx 12rpx;
		border-radius: 8rpx;
		background-color: #f4f8fc;
		flex-shrink: 1;
		max-width: 220rpx;
	}
	.key-tag__text {
		font-size: 22rpx;
		color: #6d8aa4;
	}
	.key-switch {
		display: flex;
		flex-direction: row;
		align-items: center;
		padding-left: 16rpx;
		flex-shrink: 0;
	}
	.key-switch__text {
		font-size: 24rpx;
		color: #2b7fd4;
	}
	.key-switch__arrow {
		width: 20rpx;
		height: 20rpx;
		margin-left: 4rpx;
	}

	.key-line {
		height: 1rpx;
		margin: 16rpx 0 14rpx;
		background-color: #f0f5fa;
	}

	.key-meta {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
	}
	.key-meta__item {
		display: flex;
		flex-direction: column;
		flex: 1;
	}
	.key-meta__item--gap {
		margin-left: 24rpx;
	}
	.key-meta__label {
		font-size: 22rpx;
		color: #8ba3b8;
	}
	.key-meta__value {
		margin-top: 6rpx;
		font-size: 24rpx;
		color: #14324e;
	}

	/* ===== 车控 WebView ===== */
	.key-web {
		width: 718rpx;
	}
	/* ===== 日期范围弹窗（nvue 只支持单类选择器，已拆成独立类） ===== */
	.picker-mask {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.5);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 9999;
	}

	.picker-panel {
		min-width: 600rpx;
		background: #ffffff;
		border-radius: 24rpx;
		box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.15);
		overflow: hidden;
	}

	.panel-title {
		text-align: center;
		font-size: 32rpx;
		font-weight: 500;
		color: #333;
		margin-bottom: 20rpx;
	}

	.panel-body {
		padding: 40rpx 30rpx;
	}

	.picker-item {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 28rpx 20rpx;
		margin: 10rpx 0;
		background: #f7f8fa;
		border-radius: 16rpx;
	}

	.picker-label {
		font-size: 28rpx;
		color: #555;
	}

	.picker-val {
		font-size: 28rpx;
		color: #1677ff;
		font-weight: 500;
	}

	.btn-group {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		margin-top: 40rpx;
	}

	.picker-btn {
		flex: 1;
		text-align: center;
		padding: 24rpx;
		border-radius: 16rpx;
		font-size: 28rpx;
		font-weight: 500;
	}

	.picker-btn__cancel {
		background: #f5f5f5;
		color: #666;
		margin-right: 5rpx;
	}

	.picker-btn__confirm {
		margin-left: 5rpx;
		background: #1677ff;
		color: #fff;
	}
</style>